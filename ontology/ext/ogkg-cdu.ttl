@prefix ogkg:  <https://example.org/ogkg/core#> .
@prefix vocab: <https://example.org/ogkg/vocab#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# =============================================================================
#  OGKG extension: crude distillation unit (CDU) — Sector 1a additions
#  Used by the Refinery Gamma reference model (data/cdu-gamma/).
# =============================================================================

<https://example.org/ogkg/ext/cdu> a owl:Ontology ;
    rdfs:label "OGKG refinery extension (CDU, conversion, treating, utilities)" ; owl:versionInfo "1.0.0" ; owl:versionIRI <https://example.org/ogkg/ext/cdu/1.0.0> ;
    owl:imports <https://example.org/ogkg/core> , <https://example.org/ogkg/vocab> .

# --- Units (L4)
ogkg:TankFarm          a owl:Class ; rdfs:subClassOf ogkg:PlantUnit ; rdfs:label "Tank farm" .
ogkg:CommonFacilities  a owl:Class ; rdfs:subClassOf ogkg:PlantUnit ; rdfs:label "Common facilities shared by several trains" .

# --- Sections (L5) of a CDU train
ogkg:CrudeChargeSystem       a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:ColdPreheatTrain        a owl:Class ; rdfs:subClassOf ogkg:PreheatTrain .
ogkg:HotPreheatTrain         a owl:Class ; rdfs:subClassOf ogkg:PreheatTrain .
ogkg:PreflashSystem          a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:HeaterSystem            a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:AtmosphericFractionation a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:PumparoundSystem        a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:ProductRundownSystem    a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:ChemicalInjectionSystem a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:NaphthaStabiliserSystem a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:ReliefSystem            a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:CrudeStorageSystem      a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:ChemicalStorageSystem   a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:CrudeFeedSystem         a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .

# --- Equipment (L6)
ogkg:Desalter      a owl:Class ; rdfs:subClassOf ogkg:Vessel ; rdfs:label "Electrostatic desalter" .
ogkg:Drum          a owl:Class ; rdfs:subClassOf ogkg:Vessel ; rdfs:label "Drum / receiver" .
ogkg:SideStripper  a owl:Class ; rdfs:subClassOf ogkg:Column .
ogkg:ChemicalInjectionPackage a owl:Class ; rdfs:subClassOf ogkg:StaticEquipment ; rdfs:label "Chemical injection package" .

# --- Data-point attributes (L10)
ogkg:tagType          a owl:DatatypeProperty ; rdfs:domain ogkg:DataPoint ; rdfs:range xsd:string ; rdfs:comment "ISA-5.1 function letters, e.g. TI, FI, AI." ; ogkg:facet vocab:IdentityFacet .
ogkg:measuredQuantity a owl:DatatypeProperty ; rdfs:domain ogkg:DataPoint ; rdfs:range xsd:string .
ogkg:unitLabel        a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:comment "Engineering unit as text until mapped to QUDT." .
ogkg:dataPointKind    a owl:DatatypeProperty ; rdfs:domain ogkg:DataPoint ; rdfs:range xsd:string ; rdfs:comment "sensor, analyser, lab, calculated, inspection." .
ogkg:trainId          a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:comment "Train identifier (A / B) for multi-train units." .

# --- Work performed on an asset (maintenance that is not a failure repair)
ogkg:performedOn a owl:ObjectProperty ; rdfs:domain ogkg:WorkOrder ; rdfs:range ogkg:AssetSpineNode ; ogkg:lpgType "PERFORMED_ON" .

# =============================================================================
#  Refinery-wide additions (v0.4.0): units, conversion-unit equipment
# =============================================================================
ogkg:DelayedCoker            a owl:Class ; rdfs:subClassOf ogkg:PlantUnit ; ogkg:alignedTo "Nelson: thermal processes" .
ogkg:Hydrocracker            a owl:Class ; rdfs:subClassOf ogkg:PlantUnit ; ogkg:alignedTo "Nelson: catalytic hydrocracking" .
ogkg:Hydrotreater            a owl:Class ; rdfs:subClassOf ogkg:PlantUnit ; ogkg:alignedTo "Nelson: catalytic hydrorefining / hydrotreating" .
ogkg:IsomerisationUnit       a owl:Class ; rdfs:subClassOf ogkg:PlantUnit ; ogkg:alignedTo "Nelson: aromatics / isomerisation" .
ogkg:AlkylationUnit          a owl:Class ; rdfs:subClassOf ogkg:PlantUnit ; ogkg:alignedTo "Nelson: alkylation / polymerisation" .
ogkg:OxygenatesUnit          a owl:Class ; rdfs:subClassOf ogkg:PlantUnit ; ogkg:alignedTo "Nelson: oxygenates" .
ogkg:AromaticsComplex        a owl:Class ; rdfs:subClassOf ogkg:PlantUnit ; ogkg:alignedTo "Nelson: aromatics / isomerisation" .
ogkg:LubeBaseOilPlant        a owl:Class ; rdfs:subClassOf ogkg:PlantUnit ; ogkg:alignedTo "Nelson: lubricants" .
ogkg:AsphaltUnit             a owl:Class ; rdfs:subClassOf ogkg:PlantUnit ; ogkg:alignedTo "Nelson: asphalt" .
ogkg:HydrogenPlant           a owl:Class ; rdfs:subClassOf ogkg:PlantUnit .
ogkg:AmineRegenerationUnit   a owl:Class ; rdfs:subClassOf ogkg:PlantUnit .
ogkg:SourWaterStripper       a owl:Class ; rdfs:subClassOf ogkg:PlantUnit .
ogkg:SulfurRecoveryUnit      a owl:Class ; rdfs:subClassOf ogkg:PlantUnit .
ogkg:TreatingUnit            a owl:Class ; rdfs:subClassOf ogkg:PlantUnit .
ogkg:MarineTerminal          a owl:Class ; rdfs:subClassOf ogkg:PlantUnit .
ogkg:UtilityUnit             a owl:Class ; rdfs:subClassOf ogkg:PlantUnit .

# --- Generic sections (L5) used across refinery units
ogkg:FeedSection                a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:ReactionSection            a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:SeparationSection          a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:FractionationSection       a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:CompressionSection         a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:TreatingSection            a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:FlueGasSection             a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:CokeDrumSection            a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:DecokingSection            a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:CatalystRegenerationSection a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:ExtractionSection          a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:BlendingSection            a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:StorageSection             a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:LoadingSection             a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:GenerationSection          a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .
ogkg:DistributionSection        a owl:Class ; rdfs:subClassOf ogkg:SectionSystem .

ogkg:FixedBedReactor         a owl:Class ; rdfs:subClassOf ogkg:Vessel .
ogkg:FCCReactor              a owl:Class ; rdfs:subClassOf ogkg:Vessel ; rdfs:label "FCC reactor / riser / stripper" .
ogkg:FCCRegenerator          a owl:Class ; rdfs:subClassOf ogkg:Vessel .
ogkg:SlideValve              a owl:Class ; rdfs:subClassOf ogkg:Valve .
ogkg:CentrifugalCompressor   a owl:Class ; rdfs:subClassOf ogkg:Compressor .
ogkg:ReciprocatingCompressor a owl:Class ; rdfs:subClassOf ogkg:Compressor .
ogkg:PowerRecoveryExpander   a owl:Class ; rdfs:subClassOf ogkg:RotatingEquipment .
ogkg:WasteHeatBoiler         a owl:Class ; rdfs:subClassOf ogkg:StaticEquipment .
ogkg:CokeDrum                a owl:Class ; rdfs:subClassOf ogkg:Vessel .
ogkg:DecokingSystem          a owl:Class ; rdfs:subClassOf ogkg:StaticEquipment .
ogkg:Crusher                 a owl:Class ; rdfs:subClassOf ogkg:RotatingEquipment .

# --- Nelson complexity (Sector 1a reference attribute on unit classes; values are Sector 2 facts)
ogkg:modelDepth a owl:DatatypeProperty ; rdfs:domain ogkg:PlantUnit ; rdfs:range xsd:string ;
    rdfs:comment "How deep the reference model goes for this unit: 'deep' (L6-L10 equipment and tags) or 'skeleton' (L4-L5 with unit facts)." .
ogkg:nelsonFactor a owl:DatatypeProperty ; rdfs:domain ogkg:PlantUnit ; rdfs:range xsd:decimal ;
    rdfs:comment "Nelson complexity factor applied to the unit (source cited on the fact)." .

# =============================================================================
#  v0.5 refinery-specific classes
# =============================================================================
ogkg:SaturatedGasPlant          a owl:Class ; rdfs:subClassOf ogkg:PlantUnit ; ogkg:alignedTo "Nelson: gas processing" .
ogkg:ElectricalSection          a owl:Class ; rdfs:subClassOf ogkg:SectionSystem ; rdfs:comment "Electrical supply section of a unit (substation, MCC)." .
ogkg:ThicknessMonitoringLocation a owl:Class ; rdfs:subClassOf ogkg:Part ; ogkg:alignedTo "API 570 / API 510 thickness measurement location (TML / CML)" .
